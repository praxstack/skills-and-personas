# Explicit networked setup only; runtime still uses an immutable local image ID.
# Derive from the reviewed browser image, preserving its pinned Chromium layout.
ARG BROWSER_IMAGE
FROM ${BROWSER_IMAGE}
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg=7:5.1.9-0+deb12u1 \
    && rm -rf /var/lib/apt/lists/*
USER 65534:65534
WORKDIR /tmp
