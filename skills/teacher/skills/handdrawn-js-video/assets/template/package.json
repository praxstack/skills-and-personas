{
  "name": "handdrawn-film",
  "version": "1.0.0",
  "private": true,
  "description": "Hand-drawn 2D canvas explainer film. Plain JavaScript, no build step: fonts/ and vendor/ already hold the pinned files below, so rendering needs no npm install.",
  "license": "MIT",
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/caveat-brush": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "opentype.js": "2.0.0",
    "playwright-core": "1.56.1"
  },
  "scripts": {
    "vendor": "cp node_modules/opentype.js/dist/opentype.min.js vendor/ && cp node_modules/@fontsource/patrick-hand/files/patrick-hand-latin-400-normal.woff node_modules/@fontsource/caveat-brush/files/caveat-brush-latin-400-normal.woff node_modules/@fontsource/caveat/files/caveat-latin-700-normal.woff node_modules/@fontsource/fredoka/files/fredoka-latin-600-normal.woff node_modules/@fontsource/fredoka/files/fredoka-latin-700-normal.woff node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff fonts/"
  }
}
