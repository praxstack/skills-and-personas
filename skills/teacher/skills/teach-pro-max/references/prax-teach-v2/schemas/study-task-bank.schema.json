{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prax.local/prax-teach-v2/study-task-bank.schema.json",
  "title": "Prax Teach hidden study task bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "tasks"],
  "properties": {
    "schema_version": {"const": "1"},
    "study_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "prompt", "rubric_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "outcome": {
            "enum": ["delayed_retention", "novel_transfer"]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Hidden assessment prompt retained outside the teaching workspace."
          },
          "rubric_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier for the external blind-scoring rubric."
          }
        }
      }
    }
  }
}
