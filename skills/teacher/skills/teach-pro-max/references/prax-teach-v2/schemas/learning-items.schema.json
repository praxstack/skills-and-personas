{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prax.local/schemas/learning-items.schema.json",
  "title": "Prax Teach reviewed learning-item collection",
  "description": "The single reviewed item model used by the Anki, QTI 2.2, LiaScript, and H5P exporters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "title",
    "language",
    "license",
    "source",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "collection_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "maxLength": 63
    },
    "license": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "source": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}[A-Za-z0-9_-]$|^[A-Za-z0-9]$",
      "maxLength": 128,
      "not": {
        "pattern": "\\.\\."
      }
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "answer",
        "explanation",
        "choices",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "prompt": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "answer": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "choices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        }
      }
    }
  }
}
