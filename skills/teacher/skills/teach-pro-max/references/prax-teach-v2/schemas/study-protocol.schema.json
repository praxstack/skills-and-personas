{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prax.local/prax-teach-v2/study-protocol.schema.json",
  "title": "Prax Teach learner study protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "design",
    "seed",
    "arms",
    "primary_outcomes",
    "delay_window_days",
    "confidence_level",
    "bootstrap_samples",
    "synthetic",
    "missing_outcome_policy",
    "competency_claim",
    "evidence",
    "task_bank_hash"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "study_id": {"type": "string", "minLength": 1},
    "design": {"const": "parallel_randomized"},
    "seed": {"type": "integer"},
    "arms": {
      "const": ["active-control", "teach", "prax-teach-v2"]
    },
    "primary_outcomes": {
      "const": ["delayed_retention", "novel_transfer"]
    },
    "delay_window_days": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number", "exclusiveMinimum": 0},
        "maximum": {"type": "number", "minimum": 1}
      }
    },
    "confidence_level": {"type": "number", "minimum": 0.5, "exclusiveMaximum": 1},
    "bootstrap_samples": {"type": "integer", "minimum": 200},
    "synthetic": {"type": "boolean"},
    "missing_outcome_policy": {"const": "baseline_carried_forward_zero_adjusted_change"},
    "competency_claim": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "task_bank_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Exact SHA-256 of the external hidden task-bank bytes required by allocation and analysis."
    }
  }
}
