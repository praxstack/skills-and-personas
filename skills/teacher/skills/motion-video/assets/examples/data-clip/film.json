    {
      "at": "d7", "split": [0.7, 1.3],
      "blocks": [
        { "type": "stat", "value": "=facts.value[fact=gates]", "label": "gates before anything ships" },
        { "type": "steps", "items": ["Brief", "Script", "Voice | Kokoro, timed per line", "Visuals | stills looked at, 26 px, 4.5:1", "Render", "Mix | -16 LUFS", "QA | sync, black, frozen, flicker", "Deliver"] }
