      ]
    },
    {
      "at": "d3",
      "blocks": [
        { "type": "bars", "id": "speed", "title": "Render speed", "unit": "frames/s per worker, 1080p, CPU only",
          "rows": { "from": "speeds", "x": "kit", "y": "fps", "sort": "desc" }, "format": "0.0",
          "cues": [
            { "do": "highlight", "at": "d4:motion canvas", "label": "max" },
            { "do": "highlight", "at": "d5:three j s", "label": "min" }
