    },
    {
      "at": "d8",
      "blocks": [
        { "type": "stat", "value": "=facts.value[fact=themes]", "label": "colour themes" },
        { "type": "stat", "value": "=facts.value[fact=contrast]", "format": "0.0", "suffix": ":1", "label": "contrast, at least, for every text" }
      ]
    },
    {
      "at": "d9",
      "blocks": [
        { "type": "text", "kicker": "Data in, film out", "text": "Edit the CSV. *Everything* follows.", "chips": ["data/*.csv", "film.json", "motion_fill.py"] }
