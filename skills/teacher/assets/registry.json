{
  "schema_version": "1.0",
  "checked_at": "2026-10-16",
  "purpose": "Pick the tool that makes an idea click. Rank by the job the idea needs, then by what this host can actually run (scripts/find_tool.py probes it). Official docs, install pins and verification for most third-party tools live in skills/teach-pro-max/references/prax-teach-v2/references/visualization-tool-registry.json under the same ref id.",
  "jobs": {
    "structure": "parts and how they connect",
    "process": "steps, flows, algorithm traces",
    "change": "something that varies over time or as you drag it",
    "cause": "what-if: change an input, see the effect",
    "quantity": "numbers, comparisons, distributions, data",
    "space": "geometry, 3D, physical layout, maps",
    "math": "equations, proofs, transformations",
    "code": "running and tracing real code",
    "story": "a narrated walk-through, intro or recap",
    "map": "a concept map or roadmap of a whole subject",
    "timeline": "history and sequences of events",
    "sound": "audio, music, speech, pronunciation",
    "real": "photos and footage of real things"
  },
  "media": [
    "still",
    "interactive",
    "animation",
    "video",
    "3d",
    "image",
    "audio",
    "qa",
    "host"
  ],
  "tools": [
    {
      "id": "explorable",
      "name": "Explorable lesson (bundled)",
      "media": [
        "interactive",
        "animation"
      ],
      "jobs": [
        "cause",
        "change",
        "process",
        "math",
        "quantity",
        "space"
      ],
      "how": {
        "skill": "skills/explorable/SKILL.md",
        "command": "python3 skills/explorable/scripts/build.py lesson.js -o lesson.html"
      },
      "probe": {
        "bins": [
          "python3"
        ]
      },
      "offline": true,
      "notebook": "native",
      "output": [
        "html"
      ],
      "best_for": "the default for 'teach me X': one model drives the figure, sliders, questions, film and notes",
      "avoid_when": "the learner only asked a one-line question"
    },
    {
      "id": "concept-animation",
      "name": "Concept animation (bundled)",
      "media": [
        "animation",
        "video"
      ],
      "jobs": [
        "change",
        "process",
        "math",
        "story"
      ],
      "how": {
        "skill": "skills/concept-animation/SKILL.md",
        "command": "python3 skills/concept-animation/scripts/build.py x.anim.js -o x.html && node skills/concept-animation/scripts/export.mjs x.html --out x.mp4 --gif x.gif"
      },
      "probe": {
        "bins": [
          "python3",
          "node",
          "ffmpeg"
        ],
        "node": [
          "playwright"
        ]
      },
      "offline": true,
      "notebook": "native",
      "output": [
        "html",
        "mp4",
        "gif",
        "vtt"
      ],
      "best_for": "short scrubbable clips of one transformation; exact frame export to MP4/GIF",
      "avoid_when": "the learner should be driving the change themselves (use explorable)"
    },
