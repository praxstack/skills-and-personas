# Standalone source recipe for a new ARM64 base. Explicit setup only.
# Review the resulting image and rerun controls before using its ID.
# Registry digest is the original node22 Debian12 base used for the tested image.
FROM node@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
USER 0:0
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3=3.11.2-1+b1 \
    libasound2=1.2.8-1+b1 libatk-bridge2.0-0=2.46.0-5 libatk1.0-0=2.46.0-5 \
    libcairo2=1.16.0-7 libcups2=2.4.2-3+deb12u9 libdbus-1-3=1.14.10-1~deb12u1 \
    libdrm2=2.4.114-1+b1 libgbm1=22.3.6-1+deb12u2 libnspr4=2:4.35-1 \
    libnss3=2:3.87.1-1+deb12u4 libpango-1.0-0=1.50.12+ds-1 \
    libx11-6=2:1.8.4-2+deb12u2 libxcb1=1.15-1 libxcomposite1=1:0.4.5-1 \
    libxdamage1=1:1.1.6-1 libxext6=2:1.3.4-1+b1 libxfixes3=1:6.0.0-2 \
    libxkbcommon0=1.5.0-1 libxrandr2=2:1.5.2-2+b1 \
    && rm -rf /var/lib/apt/lists/*
# Only playwright/playwright-core (both exact1.58.0); no lifecycle scripts.
# The Python runtime is assembled separately with hash-pinned wheels.
RUN npm install --prefix /opt/browser-installer --ignore-scripts --no-audit --no-fund playwright@1.58.0 \
    && /opt/browser-installer/node_modules/.bin/playwright install chromium \
    && test -x /ms-playwright/chromium_headless_shell-1208/chrome-linux/headless_shell \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /root/.npm /opt/browser-installer
USER 65534:65534
WORKDIR /tmp
