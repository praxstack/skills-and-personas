+"""Trusted Linux worker-allocation bound, in addition to Docker's CPU quota."""
+import os
+
+
+def constrain_cpu_affinity():
+    """Expose one already-allowed CPU to children; fail before authored execution.
+
+    A CPU-time quota does not constrain the CPU count used to size worker pools.
+    The container already has a one-CPU quota. Inheriting a one-CPU affinity mask
+    lets browser/media workers respect that bound without spending the fixed
+    PID budget on workers for CPUs that cannot run concurrently under the quota.
+    """
+    get_affinity = getattr(os, 'sched_getaffinity', None)
+    set_affinity = getattr(os, 'sched_setaffinity', None)
+    if not callable(get_affinity) or not callable(set_affinity):
+        raise RuntimeError('CPU affinity unavailable; no authored code ran')
+    try:
+        before = get_affinity(0)
+        if not before:
+            raise RuntimeError('no allowed CPU; no authored code ran')
+        selected = {min(before)}
+        set_affinity(0, selected)
+        after = get_affinity(0)
+    except OSError as exc:
+        raise RuntimeError('CPU affinity unavailable; no authored code ran') from exc
+    if after != selected:
+        raise RuntimeError('CPU affinity did not apply; no authored code ran')
+    return sorted(before), sorted(after)
