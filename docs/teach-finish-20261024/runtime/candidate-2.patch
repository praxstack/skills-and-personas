+"""CPU quota and inherited worker-allocation controls for the trusted supervisor."""
+import unittest
+from unittest.mock import call, patch
+
+from supervisor_resources import constrain_cpu_affinity
+
+
+class CpuAffinityTests(unittest.TestCase):
+    def test_selects_one_already_allowed_cpu_and_verifies_effective_mask(self):
+        with patch('supervisor_resources.os.sched_getaffinity', create=True, side_effect=[{3, 7}, {3}]) as get, patch('supervisor_resources.os.sched_setaffinity', create=True) as set_affinity:
+            self.assertEqual(constrain_cpu_affinity(), ([3, 7], [3]))
+        self.assertEqual(get.call_args_list, [call(0), call(0)])
+        set_affinity.assert_called_once_with(0, {3})
+
+    def test_single_cpu_is_preserved(self):
+        with patch('supervisor_resources.os.sched_getaffinity', create=True, return_value={7}), patch('supervisor_resources.os.sched_setaffinity', create=True) as set_affinity:
+            self.assertEqual(constrain_cpu_affinity(), ([7], [7]))
+        set_affinity.assert_called_once_with(0, {7})
+
+    def test_absent_denied_empty_or_unapplied_affinity_fails_closed(self):
+        with patch('supervisor_resources.os.sched_setaffinity', None, create=True), self.assertRaisesRegex(RuntimeError, 'CPU affinity unavailable'):
+            constrain_cpu_affinity()
+        with patch('supervisor_resources.os.sched_getaffinity', create=True, return_value=set()), patch('supervisor_resources.os.sched_setaffinity', create=True), self.assertRaisesRegex(RuntimeError, 'no allowed CPU'):
+            constrain_cpu_affinity()
+        with patch('supervisor_resources.os.sched_getaffinity', create=True, return_value={3, 7}), patch('supervisor_resources.os.sched_setaffinity', create=True, side_effect=PermissionError('denied')), self.assertRaisesRegex(RuntimeError, 'CPU affinity unavailable'):
+            constrain_cpu_affinity()
+        with patch('supervisor_resources.os.sched_getaffinity', create=True, return_value={3, 7}), patch('supervisor_resources.os.sched_setaffinity', create=True), self.assertRaisesRegex(RuntimeError, 'did not apply'):
+            constrain_cpu_affinity()
+
+
+if __name__ == '__main__':
+    unittest.main()
