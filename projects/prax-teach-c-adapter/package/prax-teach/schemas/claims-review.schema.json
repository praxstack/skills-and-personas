{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prax-teach.local/schemas/claims-review.schema.json",
  "title": "Claims review written by a reviewer subagent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "manifest_sha256", "rubric_version", "reviewer", "claims", "texts", "overall"],
  "properties": {
    "schema": {"const": "prax-teach/claims-review@1"},
    "job_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric_version": {"enum": ["1", "2", "3", "4"]},
    "reviewer": {"type": "object", "required": ["host"], "properties": {"host": {"type": "string"}, "agent": {"type": "string"}}},
    "claims": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "verdict", "reason"],
      "properties": {"id": {"type": "string"}, "verdict": {"enum": ["accept", "reject"]},
                     "reason": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}}}}},
    "texts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "verdict"],
      "properties": {"id": {"type": "string"}, "verdict": {"enum": ["accept", "reject"]}, "reason": {"type": "string"}}}},
    "overall": {"enum": ["accept", "reject"]}
  }
}
