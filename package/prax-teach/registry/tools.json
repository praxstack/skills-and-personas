{
  "schema": "prax-teach/tools@1",
  "note": "WP0 thin registry: the tools the switch-fallthrough slice needs, the pinned downloads for `ptk host setup`, and one ranked list per slice medium. WP8 widens `artifacts` to report 05's ranked alternatives.",
  "tools": {
    "clang": {"probe": "binary", "role": "capture compiler (runs facts)", "version_args": ["--version"]},
    "gcc-16": {"probe": "binary", "role": "diagnostics-only compiler", "version_args": ["--version"]},
    "sandbox-exec": {"probe": "sandbox", "role": "capture and render isolation"},
    "node": {"probe": "binary", "role": "Playwright and HyperFrames runtime (>= 22)", "version_args": ["--version"]},
    "npm": {"probe": "binary", "role": "installs the pinned node tools"},
    "ffmpeg": {"probe": "binary", "role": "audio assembly, loudness, mux", "version_args": ["-version"]},
    "ffprobe": {"probe": "binary", "role": "media gate", "version_args": ["-version"]},
    "whisper-cli": {"probe": "binary", "role": "caption sync gate", "version_args": ["--help"]},
    "tesseract": {"probe": "binary", "role": "OCR digit gate", "version_args": ["--version"]},
    "say": {"probe": "binary", "role": "TTS fallback (degraded)"},
    "hyperframes": {"probe": "state", "path": "tools/node/node_modules/.bin/hyperframes", "role": "video render, pinned 0.8.169"},
    "playwright": {"probe": "state", "path": "tools/node/node_modules/.bin/playwright", "role": "screenshots, visual gate"},
    "playwright-chromium": {"probe": "state", "path": "browsers", "role": "Playwright browser"},
    "hyperframes-chrome": {"probe": "state", "path": "browsers/hyperframes/mac_arm-152.0.7977.30/chrome-headless-shell-mac-arm64/chrome-headless-shell", "role": "HyperFrames render browser"},
    "kokoro": {"probe": "state", "path": "venvs/kokoro/bin/python", "role": "batched local TTS"},
    "kokoro-model": {"probe": "state", "path": "models/kokoro/kokoro-v1.0.onnx", "role": "Kokoro-82M model"},
    "whisper-model": {"probe": "state", "path": "models/whisper/ggml-base.en.bin", "role": "whisper base.en"},
    "core-venv": {"probe": "state", "path": "venvs/core/bin/python", "role": "jsonschema, fontTools"}
  },
  "artifacts": {
    "still": [
      {"id": "ptk-svg+playwright-png", "rank": 1, "needs": ["node", "playwright", "playwright-chromium"]}
    ],
    "video": [
      {"id": "hyperframes+kokoro", "rank": 1, "needs": ["hyperframes", "hyperframes-chrome", "kokoro", "kokoro-model", "ffmpeg"]},
      {"id": "hyperframes+hyperframes-tts", "rank": 2, "needs": ["hyperframes", "hyperframes-chrome", "ffmpeg"]},
      {"id": "hyperframes+say", "rank": 3, "needs": ["hyperframes", "hyperframes-chrome", "say", "ffmpeg"]}
    ],
    "ive": [
      {"id": "mp4+webvtt-metadata", "rank": 1, "needs": ["hyperframes", "ffmpeg", "playwright"]}
    ]
  },
  "install_hints": {
    "clang": "xcode-select --install (needs Prax's OK)",
    "gcc-16": "brew install gcc (needs Prax's OK)",
    "node": "mise use -g node@lts",
    "ffmpeg": "brew install ffmpeg (needs Prax's OK)",
    "ffprobe": "brew install ffmpeg (needs Prax's OK)",
    "whisper-cli": "brew install whisper-cpp (needs Prax's OK)",
    "tesseract": "brew install tesseract (needs Prax's OK)",
    "python3": "mise use -g python@3.13"
  },
  "hyperframes_chrome": {
    "version": "152.0.7977.30",
    "dir": "mac_arm-152.0.7977.30",
    "binary": "chrome-headless-shell-mac-arm64/chrome-headless-shell"
  },
  "downloads": [
