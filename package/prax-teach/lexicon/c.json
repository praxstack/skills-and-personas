{"schema": "prax-teach/lexicon@1", "version": "5", "note": "Spoken forms for C code tokens. `code: true` tokens are excluded from the non-code WER (AC-5.5). `heard` lists what whisper may write for a correct reading (normalised words); the sync gate fails a cue whose code token is heard as none of them. Matching is whole-word, case-sensitive. `patterns` are regex respellings applied after the tokens, in order (round 18): narration `text` is the written form and the voice reads lexicon(text); a lesson never authors a spoken form.", "entries": [{"token": "puts", "spoken": "put-s", "code": true, "heard": ["puts", "put s", "put's"]}, {"token": "printf", "spoken": "print-f", "code": true, "heard": ["printf", "print f", "print-f"]}, {"token": "n", "spoken": "en", "code": true, "heard": ["n", "en"]}, {"token": "\\n", "spoken": "newline", "code": true, "heard": ["newline", "new line"]}, {"token": "==", "spoken": "equals equals", "code": true, "heard": ["equals equals", "equal equal", "double equals"]}, {"token": "int", "spoken": "int", "code": true, "heard": ["int", "inch"]}, {"token": "char", "spoken": "char", "code": true, "heard": ["char"]}, {"token": "sizeof", "spoken": "size of", "code": true, "heard": ["sizeof", "size of"]}, {"token": "ReLU", "spoken": "raylu", "code": true, "heard": ["relu", "ray lou", "ray loo", "rayloo", "ray-loo", "re lu", "relo", "raylu", "ray lu", "rayleigh", "really"]}, {"token": "%d", "spoken": "percent d", "code": true, "heard": ["percent d", "d", "% d"]}, {"token": "%u", "spoken": "percent u", "code": true, "heard": ["percent u", "u", "% u"]}, {"token": "%f", "spoken": "percent f", "code": true, "heard": ["percent f", "f", "% f"]}, {"token": "%c", "spoken": "percent c", "code": true, "heard": ["percent c", "c", "% c"]}, {"token": "%g", "spoken": "percent g", "code": true, "heard": ["percent g", "g", "% g"]}, {"token": "ub.c", "spoken": "U B dot C", "code": true, "heard": ["ub dot c", "u b dot c", "ub.c", "you be dot c", "u.b. dot c"]}, {"token": "with_break.c", "spoken": "with-break dot C", "code": true, "heard": ["with break c", "with break dot c", "with_break.c", "withbreak c", "withbreak dot c"]}, {"token": "fallthrough.c", "spoken": "fallthrough dot C", "code": true, "heard": ["fall through c", "fall through dot c", "fallthrough c", "fallthrough dot c", "fallthrough.c"]}, {"token": "into_break.c", "spoken": "into-break dot C", "code": true, "heard": ["into break c", "into break dot c", "into_break.c", "intobreak c", "intobreak dot c", "in to break dot c", "into break.c"]}, {"token": "gcc-16", "spoken": "G C C 16", "code": true, "heard": ["gcc 16", "g c c 16", "gcc sixteen", "g c c sixteen", "gcc16", "gcc-16", "gcc 16."]}, {"token": "(double)a", "spoken": "the cast to double", "code": false}, {"token": "(unsigned)a", "spoken": "the cast to unsigned", "code": false}, {"token": "max(0, z)", "spoken": "the larger of 0 and z", "code": false}, {"token": "-Wimplicit-fallthrough", "spoken": "the implicit fallthrough warning", "code": false}, {"token": "-Wextra", "spoken": "W extra", "code": false}], "patterns": [{"pattern": "\\b([A-Za-z_]\\w*)\\((-?\\d+)\\)", "spoken": "\\1 of \\2", "note": "factorial(3) -> factorial of 3"}, {"pattern": "\\b(\\d+)\\.000000\\b", "spoken": "\\1 followed by a point and six zeros", "note": "%f output"}, {"pattern": "(?<![\\w.])\\b([01])([01])([01])([01])([01])([01])([01])([01])\\b", "spoken": "\\1 \\2 \\3 \\4 \\5 \\6 \\7 \\8", "note": "eight bits, read one by one"}, {"pattern": "\\b0x([0-9A-Fa-f]{1,4})\\b", "spoken": "hex \\1", "note": "short hex constants"}, {"pattern": "(?<=\\w) - (?=[\\w(])", "spoken": " minus ", "note": "binary minus"}, {"pattern": "(?<=\\w) > (?=\\w)", "spoken": " greater than "}, {"pattern": "(?<=\\w) = (?=[\\w(+\\-])", "spoken": " equals "}, {"pattern": " × ", "spoken": " times "}, {"pattern": " \\* ", "spoken": " times "}, {"pattern": " \\*(?=\\s|$)", "spoken": " times"}, {"pattern": "(?<![\\w.])-(?=\\d)", "spoken": "minus "}, {"pattern": "(?<![\\w.])\\+(?=\\d)", "spoken": "plus "}, {"pattern": "(\\d\\.\\d+)\\.$", "spoken": "\\1 .", "note": "a decimal that ends the line keeps its point: Kokoro read a final 0.6. as zero, six (B5)"}]}
