{
  "schema": "prax-teach/tokens@2",
  "note": "Style tokens (references/STYLE.md). Projectors read colours by semantic role and type by type role, never by hex or family name. `aliases` keeps the WP0 colour names working for the video and IVE projectors.",
  "fonts": {
    "serif": {"family": "Source Serif 4", "file": "SourceSerif4-Roman.woff2", "weight": "200 900", "style": "normal", "fallback": "serif"},
    "serif_italic": {"family": "Source Serif 4", "file": "SourceSerif4-Italic.woff2", "weight": "200 900", "style": "italic", "fallback": "serif"},
    "sans": {"family": "Nunito Sans", "file": "NunitoSans.woff2", "weight": "300 900", "style": "normal", "fallback": "sans-serif"},
    "mono": {"family": "JetBrains Mono", "file": "JetBrainsMono.woff2", "weight": "100 800", "style": "normal", "fallback": "monospace"},
    "hand": {"family": "Caveat", "file": "Caveat.woff2", "weight": "400 700", "style": "normal", "fallback": "cursive"}
  },
  "numeric": "lining-nums tabular-nums",
  "roles": {
    "ground": "page background",
    "surface": "card or code panel background",
    "ink": "primary text and executed code",
    "ink_soft": "secondary prose, string literals",
    "label": "section labels, provenance, muted tags",
    "faint": "line numbers and step numbers",
    "rule": "rules, dividers and card borders (3:1 graphics)",
    "note": "annotations, the execution path, links, emphasis",
    "note_tint": "background behind note-coloured text",
    "correction": "warnings and the wrong-belief marker (no break)",
    "correction_tint": "background behind correction-coloured text",
    "value": "captured output values",
    "highlight": "background of executed code lines"
  },
  "aliases": {
    "paper": "ground", "card": "surface", "soft": "ink_soft", "muted": "label", "blue": "note",
    "blue_tint": "note_tint", "red": "correction", "red_tint": "correction_tint", "hl": "highlight"
  },
  "themes": {
    "light": {
      "ground": "#fbfaf4", "surface": "#fffefa", "ink": "#171d29", "ink_soft": "#3f4656", "label": "#596070",
      "faint": "#6b7180", "rule": "#857f70", "note": "#183a94", "note_tint": "#e6ecfa", "correction": "#c0392b",
      "correction_tint": "#fbecea", "value": "#171d29", "highlight": "#dfe7fb",
      "frame": {"card_border": false, "panel_fill": false, "panel_divider": true},
      "type": {
        "kicker": {"font": "sans", "weight": 700, "caps": true, "spacing": 1.6, "scale": 1},
        "display": {"font": "sans", "weight": 800, "scale": 0.86},
        "body": {"font": "sans", "weight": 400, "scale": 0.95},
        "caption": {"font": "sans", "weight": 400, "scale": 0.95},
        "label": {"font": "sans", "weight": 600, "caps": true, "spacing": 1.2, "scale": 1.04},
        "note": {"font": "sans", "weight": 600, "scale": 0.8},
        "tag": {"font": "mono", "weight": 400, "scale": 1},
        "code": {"font": "mono", "weight": 400, "scale": 1},
        "value": {"font": "mono", "weight": 500, "scale": 1},
        "foot": {"font": "mono", "weight": 400, "scale": 1}
      }
    },
    "dark": {
      "ground": "#101828", "surface": "#172136", "ink": "#edf1f7", "ink_soft": "#c8d1df", "label": "#aebbd0",
      "faint": "#8f9db6", "rule": "#64738e", "note": "#c4b5fd", "note_tint": "#262046", "correction": "#ea6a5e",
      "correction_tint": "#371a24", "value": "#93e6ce", "highlight": "#262f50",
      "frame": {"card_border": false, "panel_fill": false, "panel_divider": true},
      "type": {
        "kicker": {"font": "sans", "weight": 700, "caps": true, "spacing": 1.6, "scale": 1},
        "display": {"font": "sans", "weight": 800, "scale": 0.86},
        "body": {"font": "sans", "weight": 400, "scale": 0.95},
        "caption": {"font": "sans", "weight": 400, "scale": 0.95},
        "label": {"font": "sans", "weight": 600, "caps": true, "spacing": 1.2, "scale": 1.04},
        "note": {"font": "sans", "weight": 600, "scale": 0.8},
        "tag": {"font": "mono", "weight": 400, "scale": 1},
        "code": {"font": "mono", "weight": 400, "scale": 1},
        "value": {"font": "mono", "weight": 500, "scale": 1},
        "foot": {"font": "mono", "weight": 400, "scale": 1}
      }
    }
  },
  "contrast_pairs": [
    ["ink", "ground", 4.5], ["ink", "surface", 4.5], ["ink", "highlight", 4.5],
    ["ink_soft", "ground", 4.5], ["ink_soft", "surface", 4.5], ["ink_soft", "highlight", 4.5],
    ["label", "ground", 4.5], ["label", "surface", 4.5],
    ["faint", "ground", 4.5], ["faint", "surface", 4.5],
    ["note", "ground", 4.5], ["note", "surface", 4.5], ["note", "highlight", 4.5], ["note", "note_tint", 4.5],
    ["correction", "ground", 4.5], ["correction", "surface", 4.5], ["correction", "correction_tint", 4.5],
    ["value", "ground", 4.5], ["value", "surface", 4.5],
    ["surface", "note", 4.5],
    ["rule", "ground", 3.0], ["rule", "surface", 3.0],
    ["note", "ground", 3.0], ["note", "surface", 3.0], ["correction", "correction_tint", 3.0]
  ],
  "separation": {"light": [["note", "correction", 15.0]], "dark": [["note", "correction", 15.0]]}
}
