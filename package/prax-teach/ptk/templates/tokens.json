{
  "schema": "prax-teach/tokens@1",
  "fonts": {
    "serif": {"family": "Source Serif 4", "file": "SourceSerif4-Roman.woff2", "weight": "200 900", "style": "normal"},
    "serif_italic": {"family": "Source Serif 4", "file": "SourceSerif4-Italic.woff2", "weight": "200 900", "style": "italic"},
    "mono": {"family": "JetBrains Mono", "file": "JetBrainsMono.woff2", "weight": "100 800", "style": "normal"},
    "hand": {"family": "Caveat", "file": "Caveat.woff2", "weight": "400 700", "style": "normal"}
