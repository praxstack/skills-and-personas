    ["muted", "paper", 4.5], ["muted", "card", 4.5], ["faint", "card", 4.5], ["blue", "paper", 4.5], ["blue", "card", 4.5],
    ["blue", "hl", 4.5], ["ink", "hl", 4.5], ["red", "paper", 4.5], ["red", "card", 4.5], ["red", "red_tint", 4.5],
    ["ink", "blue_tint", 4.5], ["blue", "blue_tint", 4.5],
    ["rule", "paper", 3.0], ["rule", "card", 3.0], ["blue", "paper", 3.0]
  ]
